# Local (non-Docker) development configuration for the Telegram bot.
# Copy to ".env" inside apps/telegram-bot/ when running `python -m bot.main` directly.

BOT_TOKEN=123456789:AAour-telegram-bot-token-here
BACKEND_API_BASE_URL=http://localhost:8000/api
BOT_INTERNAL_API_KEY=dev-internal-key-change-me
REDIS_URL=redis://localhost:6379/1
USE_REDIS_FSM_STORAGE=true
