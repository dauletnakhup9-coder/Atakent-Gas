# Local (non-Docker) development configuration for the backend.
# Copy to ".env" inside apps/backend/ when running `uvicorn` directly.

ENVIRONMENT=development
SECRET_KEY=dev-secret-key-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=480

DATABASE_URL=postgresql+asyncpg://gas_service:gas_service@localhost:5432/gas_service
REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=http://localhost:3000

BOT_INTERNAL_API_KEY=dev-internal-key-change-me
BOT_TOKEN=

UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp

RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_LOGIN=5/minute
