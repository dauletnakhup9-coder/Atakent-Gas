# ==========================================================================
# Gas Service Requests System — environment configuration
# Copy this file to ".env" in the project root and fill in real values.
# NEVER commit the real ".env" file to Git.
# ==========================================================================

# ---- PostgreSQL ----
POSTGRES_USER=gas_service
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=gas_service

# ---- Backend (FastAPI) ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
ENVIRONMENT=production

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost,http://localhost:3000

# Shared secret between the backend and the Telegram bot for the internal
# /api/bot/* endpoints. Generate with the same command as SECRET_KEY.
BOT_INTERNAL_API_KEY=change-me-to-a-long-random-secret

MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp

RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_LOGIN=5/minute

# ---- Telegram Bot ----
# Obtained from @BotFather, see README "Creating the Telegram Bot".
BOT_TOKEN=123456789:AAour-telegram-bot-token-here

# ---- Frontend (Next.js admin dashboard) ----
# Public base URL the browser uses to reach the API. When served behind the
# bundled nginx reverse proxy (recommended), this stays a relative "/api".
NEXT_PUBLIC_API_BASE_URL=/api

# ---- Nginx ----
HTTP_PORT=80
HTTPS_PORT=443
